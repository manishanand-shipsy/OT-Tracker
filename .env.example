# Copy this to .env on the server before running `docker compose up --build -d`.
# This .env is read by docker-compose.yml (NOT by the app directly in production —
# the app service gets its env vars injected by docker-compose).

# Postgres password for the db container (pick your own).
POSTGRES_PASSWORD=change-me

# The public URL this app will be reached at (used by NextAuth for callbacks).
# Must match the "Authorized redirect URI" you configure in Google Cloud
# Console as: <NEXTAUTH_URL>/api/auth/callback/google
NEXTAUTH_URL=https://overtime.yourcompany.com

# Random secret NextAuth uses to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth client, from Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack bot token for DMing approvers when an entry needs their decision.
# Create a Slack app at https://api.slack.com/apps with Bot Token Scopes
# `users:read.email`, `im:write`, and `chat:write`, install it to your
# workspace, and paste the "Bot User OAuth Token" (starts with xoxb-) here.
# Leave blank to skip Slack notifications entirely.
SLACK_BOT_TOKEN=
